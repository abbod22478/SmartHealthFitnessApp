<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.health.app.controller.AddFoodController"
           styleClass="root-pane"
           stylesheets="@dashboard.css">

    <!-- Glow orbs -->
    <Region styleClass="glow-orb-orange"
            prefWidth="380" prefHeight="380"
            maxWidth="380" maxHeight="380"
            translateX="-140" translateY="-260"/>

    <Region styleClass="glow-orb-red"
            prefWidth="360" prefHeight="360"
            maxWidth="360" maxHeight="360"
            translateX="160" translateY="280"/>

    <VBox spacing="0" alignment="TOP_LEFT">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <!-- Top bar with back button + title -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Button text="←" styleClass="small-back-button"
                    onAction="#backToMeals"
                    prefWidth="42" prefHeight="42"/>
            <VBox spacing="2">
                <Label text="Nutrition" styleClass="welcome-label"/>
                <Label text="Add food" styleClass="user-name"/>
            </VBox>
        </HBox>

        <Region prefHeight="22"/>

        <!-- SELECT FOOD section -->
        <Label text="SELECT FOOD" styleClass="food-section-label"/>

        <Region prefHeight="12"/>
        <!-- Free text input section (FR18-FR21) -->
        <Label text="OR ENTER AS TEXT" styleClass="food-section-label"/>
        <Region prefHeight="6"/>

        <HBox spacing="8" alignment="CENTER_LEFT">
            <TextField fx:id="textInputField"
                       styleClass="food-input"
                       promptText='e.g. "chicken breast 200g"'
                       HBox.hgrow="ALWAYS"/>
            <Button text="Parse"
                    onAction="#parseTextInput"
                    styleClass="next-button"
                    prefWidth="80" prefHeight="48"/>
        </HBox>

        <Label fx:id="textParseResultLabel" text="" wrapText="true"
               style="-fx-font-size: 12px;"/>

        <Region prefHeight="10"/>
        <Label text="OR SELECT FROM DATABASE" styleClass="food-section-label"/>
        <Region prefHeight="6"/>

        <!-- Food item label -->
        <Label text="Food item from database" styleClass="food-section-label"
               style="-fx-text-fill: #9A9AA8; -fx-font-size: 11px;"/>

        <Region prefHeight="6"/>

        <!-- Food item dropdown -->
        <ComboBox fx:id="foodItemBox"
                  styleClass="food-combo-box"
                  promptText="Choose food item"
                  maxWidth="Infinity"/>

        <Region prefHeight="14"/>

        <!-- Meal type label -->
        <Label text="Meal type" styleClass="food-section-label"
               style="-fx-text-fill: #9A9AA8; -fx-font-size: 11px;"/>

        <Region prefHeight="6"/>

        <!-- Meal type dropdown -->
        <ComboBox fx:id="mealTypeBox"
                  styleClass="food-combo-box"
                  promptText="Select meal"
                  maxWidth="Infinity"/>

        <Region prefHeight="14"/>

        <!-- Quantity label -->
        <Label text="Quantity in grams" styleClass="food-section-label"
               style="-fx-text-fill: #9A9AA8; -fx-font-size: 11px;"/>

        <Region prefHeight="6"/>

        <!-- Quantity input -->
        <TextField fx:id="quantityField"
                   styleClass="food-input"
                   promptText="e.g. 150"
                   maxWidth="Infinity"/>

        <Region prefHeight="20"/>

        <!-- CALCULATED NUTRITION section -->
        <Label text="CALCULATED NUTRITION" styleClass="food-section-label"/>

        <Region prefHeight="12"/>

        <!-- 2x2 grid of nutrition cards -->
        <GridPane hgap="10" vgap="10">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>

            <!-- Calories card -->
            <VBox styleClass="calc-card" spacing="4"
                  GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="CALORIES" styleClass="calc-label"/>
                <HBox alignment="BASELINE_LEFT" spacing="2">
                    <Label fx:id="calculatedCaloriesLabel" text="0" styleClass="calc-value"/>
                    <Label text="kcal" styleClass="calc-unit"/>
                </HBox>
            </VBox>

            <!-- Protein card -->
            <VBox styleClass="calc-card" spacing="4"
                  GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label text="PROTEIN" styleClass="calc-label"/>
                <HBox alignment="BASELINE_LEFT" spacing="2">
                    <Label fx:id="calculatedProteinLabel" text="0" styleClass="calc-value"/>
                    <Label text="g" styleClass="calc-unit"/>
                </HBox>
            </VBox>

            <!-- Carbs card -->
            <VBox styleClass="calc-card" spacing="4"
                  GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label text="CARBS" styleClass="calc-label"/>
                <HBox alignment="BASELINE_LEFT" spacing="2">
                    <Label fx:id="calculatedCarbsLabel" text="0" styleClass="calc-value"/>
                    <Label text="g" styleClass="calc-unit"/>
                </HBox>
            </VBox>

            <!-- Fats card -->
            <VBox styleClass="calc-card" spacing="4"
                  GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label text="FATS" styleClass="calc-label"/>
                <HBox alignment="BASELINE_LEFT" spacing="2">
                    <Label fx:id="calculatedFatsLabel" text="0" styleClass="calc-value"/>
                    <Label text="g" styleClass="calc-unit"/>
                </HBox>
            </VBox>
        </GridPane>

        <Region prefHeight="10"/>

        <!-- Message label (success/error) -->
        <Label fx:id="messageLabel" text="" styleClass="food-message" wrapText="true"/>

        <!-- Spacer -->
        <Region VBox.vgrow="ALWAYS"/>

        <!-- Save button -->
        <Button text="Save meal log"
                onAction="#saveFood"
                styleClass="next-button"
                maxWidth="Infinity"
                prefHeight="52"/>

    </VBox>
</StackPane>