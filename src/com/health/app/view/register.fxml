<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.health.app.controller.RegisterController"
            prefWidth="1050"
            prefHeight="680"
            style="-fx-background-color: linear-gradient(to bottom right, #0F172A, #111827);">

    <center>
        <HBox alignment="CENTER" spacing="0">
            <padding>
                <Insets top="45" right="45" bottom="45" left="45"/>
            </padding>

            <VBox prefWidth="390"
                  prefHeight="560"
                  spacing="26"
                  style="-fx-background-color: linear-gradient(to bottom right, #064E3B, #16A34A);
                         -fx-background-radius: 28 0 0 28;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.35), 30, 0.2, 0, 12);">

                <padding>
                    <Insets top="55" right="38" bottom="38" left="38"/>
                </padding>

                <Label text="Smart Health"
                       style="-fx-text-fill: white; -fx-font-size: 38px; -fx-font-weight: 900;"/>

                <Label text="Your personalized fitness and nutrition companion."
                       wrapText="true"
                       style="-fx-text-fill: #DCFCE7; -fx-font-size: 17px; -fx-line-spacing: 6;"/>

                <VBox spacing="14">
                    <Label text="✓ Personalized meal plans"
                           style="-fx-text-fill: white; -fx-font-size: 15px;"/>
                    <Label text="✓ Workout tracking"
                           style="-fx-text-fill: white; -fx-font-size: 15px;"/>
                    <Label text="✓ Progress reports"
                           style="-fx-text-fill: white; -fx-font-size: 15px;"/>
                    <Label text="✓ Smart reminders"
                           style="-fx-text-fill: white; -fx-font-size: 15px;"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <Label text="Build better habits, one day at a time."
                       wrapText="true"
                       style="-fx-text-fill: #BBF7D0; -fx-font-size: 14px;"/>
            </VBox>

            <VBox prefWidth="570"
                  prefHeight="560"
                  alignment="CENTER"
                  spacing="22"
                  style="-fx-background-color: rgba(255,255,255,0.96);
                         -fx-background-radius: 0 28 28 0;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.30), 30, 0.2, 0, 12);">

                <padding>
                    <Insets top="45" right="60" bottom="45" left="60"/>
                </padding>

                <VBox alignment="CENTER" spacing="8">
                    <Label text="Create Account"
                           style="-fx-text-fill: #0F172A; -fx-font-size: 34px; -fx-font-weight: 900;"/>
                    <Label text="Start your journey with a clean health profile"
                           style="-fx-text-fill: #64748B; -fx-font-size: 14px;"/>
                </VBox>

                <GridPane hgap="14" vgap="16" maxWidth="460">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>

                    <TextField fx:id="nameField" promptText="Full Name"
                               GridPane.columnIndex="0" GridPane.rowIndex="0"
                               style="-fx-background-radius: 12; -fx-pref-height: 44; -fx-font-size: 13px;"/>

                    <TextField fx:id="emailField" promptText="Email Address"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"
                               style="-fx-background-radius: 12; -fx-pref-height: 44; -fx-font-size: 13px;"/>

                    <PasswordField fx:id="passwordField" promptText="Password"
                                   GridPane.columnIndex="0" GridPane.rowIndex="1"
                                   style="-fx-background-radius: 12; -fx-pref-height: 44; -fx-font-size: 13px;"/>

                    <TextField fx:id="ageField" promptText="Age"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"
                               style="-fx-background-radius: 12; -fx-pref-height: 44; -fx-font-size: 13px;"/>

                    <ComboBox fx:id="genderBox" promptText="Gender" maxWidth="Infinity"
                              GridPane.columnIndex="0" GridPane.rowIndex="2"
                              style="-fx-background-radius: 12; -fx-pref-height: 44; -fx-font-size: 13px;"/>

                    <ComboBox fx:id="goalBox" promptText="Fitness Goal" maxWidth="Infinity"
                              GridPane.columnIndex="1" GridPane.rowIndex="2"
                              style="-fx-background-radius: 12; -fx-pref-height: 44; -fx-font-size: 13px;"/>

                    <TextField fx:id="heightField" promptText="Height (cm)"
                               GridPane.columnIndex="0" GridPane.rowIndex="3"
                               style="-fx-background-radius: 12; -fx-pref-height: 44; -fx-font-size: 13px;"/>

                    <TextField fx:id="weightField" promptText="Weight (kg)"
                               GridPane.columnIndex="1" GridPane.rowIndex="3"
                               style="-fx-background-radius: 12; -fx-pref-height: 44; -fx-font-size: 13px;"/>
                </GridPane>

                <Label fx:id="messageLabel"
                       text=""
                       style="-fx-font-size: 13px; -fx-font-weight: bold;"/>

                <Button text="Create My Account"
                        onAction="#handleRegister"
                        prefWidth="460"
                        prefHeight="48"
                        style="-fx-background-color: linear-gradient(to right, #16A34A, #22C55E);
                               -fx-text-fill: white;
                               -fx-font-size: 15px;
                               -fx-font-weight: 900;
                               -fx-background-radius: 14;
                               -fx-cursor: hand;"/>

                <Label text="Already have an account? Sign in"
                       style="-fx-text-fill: #16A34A; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>