<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.health.app.controller.DashboardController"
           prefWidth="430"
           prefHeight="760"
           minWidth="430"
           minHeight="760"
           maxWidth="430"
           maxHeight="760"
           styleClass="root-pane"
           stylesheets="/com/health/app/view/dashboard.css">

    <Region styleClass="glow-orb-orange"
            prefWidth="380" prefHeight="380"
            maxWidth="380" maxHeight="380"
            translateX="-140" translateY="-260"/>

    <Region styleClass="glow-orb-red"
            prefWidth="360" prefHeight="360"
            maxWidth="360" maxHeight="360"
            translateX="160" translateY="280"/>

    <VBox spacing="14"
          alignment="TOP_CENTER"
          prefWidth="430" prefHeight="760"
          minWidth="430" minHeight="760"
          maxWidth="430" maxHeight="760">

        <padding>
            <Insets top="22" right="20" bottom="14" left="20"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Welcome back" styleClass="welcome-label"/>
                <Label fx:id="userNameLabel" text="Hi, User" styleClass="user-name"/>
            </VBox>
            <StackPane styleClass="avatar-circle">
                <Label fx:id="avatarLabel" text="U" styleClass="avatar-text"/>
            </StackPane>
        </HBox>

        <HBox styleClass="ring-card" alignment="CENTER_LEFT" spacing="14">
            <StackPane prefWidth="130" prefHeight="130"
                       minWidth="130" minHeight="130"
                       maxWidth="130" maxHeight="130">
                <StackPane styleClass="percent-ring">
                    <VBox alignment="CENTER" spacing="0">
                        <Label fx:id="ringPercentLabel" text="0%" styleClass="ring-percent-text"/>
                        <Label text="logged" styleClass="ring-percent-label"/>
                    </VBox>
                </StackPane>
            </StackPane>

            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="DAILY CALORIES" styleClass="ring-label"/>
                <Label fx:id="caloriesValueLabel" text="0" styleClass="ring-big-number"/>
                <Label fx:id="caloriesTargetLabel" text="/ 0 kcal" styleClass="ring-target"/>
                <Label fx:id="caloriesRemainingLabel" text="0 left today" styleClass="ring-remaining">
                    <padding><Insets top="4"/></padding>
                </Label>
            </VBox>
        </HBox>

        <HBox spacing="8">

            <VBox styleClass="macro-card" spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label text="PROTEIN" styleClass="macro-label"/>
                <HBox alignment="BASELINE_LEFT" spacing="2">
                    <Label fx:id="proteinValueLabel" text="0" styleClass="macro-value"/>
                    <Label fx:id="proteinTargetLabel" text="/ 0g" styleClass="macro-unit"/>
                </HBox>
                <StackPane alignment="CENTER_LEFT" styleClass="macro-bar-track">
                    <Region fx:id="proteinBarFill" styleClass="macro-bar-fill" prefWidth="0"/>
                </StackPane>
            </VBox>

            <VBox styleClass="macro-card" spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label text="CARBS" styleClass="macro-label"/>
                <HBox alignment="BASELINE_LEFT" spacing="2">
                    <Label fx:id="carbsValueLabel" text="0" styleClass="macro-value"/>
                    <Label fx:id="carbsTargetLabel" text="/ 0g" styleClass="macro-unit"/>
                </HBox>
                <StackPane alignment="CENTER_LEFT" styleClass="macro-bar-track">
                    <Region fx:id="carbsBarFill" styleClass="macro-bar-fill" prefWidth="0"/>
                </StackPane>
            </VBox>

            <VBox styleClass="macro-card" spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label text="FATS" styleClass="macro-label"/>
                <HBox alignment="BASELINE_LEFT" spacing="2">
                    <Label fx:id="fatsValueLabel" text="0" styleClass="macro-value"/>
                    <Label fx:id="fatsTargetLabel" text="/ 0g" styleClass="macro-unit"/>
                </HBox>
                <StackPane alignment="CENTER_LEFT" styleClass="macro-bar-track">
                    <Region fx:id="fatsBarFill" styleClass="macro-bar-fill" prefWidth="0"/>
                </StackPane>
            </VBox>

        </HBox>

        <Label text="Quick actions" styleClass="section-title">
            <padding><Insets top="6"/></padding>
        </Label>

        <GridPane hgap="8" vgap="8">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>

            <HBox styleClass="action-card" alignment="CENTER_LEFT" spacing="10"
                  onMouseClicked="#openMeals"
                  GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="+" styleClass="action-icon"/>
                <Label text="Log meal" styleClass="action-text"/>
            </HBox>

            <HBox styleClass="action-card" alignment="CENTER_LEFT" spacing="10"
                  onMouseClicked="#openWorkout"
                  GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label text="▶" styleClass="action-icon"/>
                <Label text="Workout" styleClass="action-text"/>
            </HBox>

            <HBox styleClass="action-card" alignment="CENTER_LEFT" spacing="10"
                  onMouseClicked="#openProgress"
                  GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label text="↑" styleClass="action-icon"/>
                <Label text="Progress" styleClass="action-text"/>
            </HBox>

            <HBox styleClass="action-card" alignment="CENTER_LEFT" spacing="10"
                  onMouseClicked="#openReminders"
                  GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label text="◉" styleClass="action-icon"/>
                <Label text="Reminders" styleClass="action-text"/>
            </HBox>
        </GridPane>

        <Region VBox.vgrow="ALWAYS"/>

        <HBox styleClass="bottom-nav" alignment="CENTER" spacing="0">
            <VBox styleClass="nav-item" alignment="CENTER" spacing="2" HBox.hgrow="ALWAYS">
                <Label text="⌂" styleClass="nav-icon-active"/>
                <Label text="HOME" styleClass="nav-text-active"/>
            </VBox>
            <VBox styleClass="nav-item" alignment="CENTER" spacing="2" HBox.hgrow="ALWAYS"
                  onMouseClicked="#openMeals">
                <Label text="🍴" styleClass="nav-icon"/>
                <Label text="MEALS" styleClass="nav-text"/>
            </VBox>
            <VBox styleClass="nav-item" alignment="CENTER" spacing="2" HBox.hgrow="ALWAYS"
                  onMouseClicked="#openWorkout">
                <Label text="▣" styleClass="nav-icon"/>
                <Label text="WORKOUT" styleClass="nav-text"/>
            </VBox>
            <VBox styleClass="nav-item" alignment="CENTER" spacing="2" HBox.hgrow="ALWAYS"
                  onMouseClicked="#openProgress">
                <Label text="↑" styleClass="nav-icon"/>
                <Label text="PROGRESS" styleClass="nav-text"/>
            </VBox>
        </HBox>

    </VBox>
</StackPane>