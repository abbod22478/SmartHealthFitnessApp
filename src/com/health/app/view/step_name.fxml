<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      spacing="0" alignment="TOP_LEFT">

    <Label text="What should we call you?" styleClass="question-heading" wrapText="true"/>
    <Region prefHeight="10"/>
    <Label text="We'll use this name across your app." styleClass="question-subtitle" wrapText="true"/>
    <Region prefHeight="20"/>
    <TextField fx:id="nameField" promptText="Enter your name" styleClass="input-field" maxWidth="Infinity"/>

</VBox>