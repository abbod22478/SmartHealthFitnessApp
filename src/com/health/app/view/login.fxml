<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.health.app.controller.LoginController"
           prefWidth="430"
           prefHeight="760"
           styleClass="root-pane"
           stylesheets="@onboarding.css">

    <!-- Glow orbs -->
    <Region styleClass="glow-orb-orange"
            prefWidth="400" prefHeight="400"
            maxWidth="400" maxHeight="400"
            translateX="-150" translateY="-280"/>

    <Region styleClass="glow-orb-red"
            prefWidth="380" prefHeight="380"
            maxWidth="380" maxHeight="380"
            translateX="170" translateY="290"/>

    <VBox spacing="0" alignment="TOP_LEFT">
        <padding>
            <Insets top="60" right="24" bottom="24" left="24"/>
        </padding>

        <!-- App title -->
        <Label text="Smart Health"
               style="-fx-text-fill: #FF8A3D; -fx-font-size: 16px; -fx-font-weight: bold;"/>

        <Region prefHeight="6"/>

        <Label text="Welcome back"
               styleClass="question-heading"
               wrapText="true"/>

        <Region prefHeight="8"/>

        <Label text="Sign in to continue your health journey."
               styleClass="question-subtitle"
               wrapText="true"/>

        <Region prefHeight="40"/>

        <!-- Email -->
        <Label text="Email"
               style="-fx-text-fill: #9A9AA8; -fx-font-size: 12px; -fx-font-weight: bold;"/>

        <Region prefHeight="8"/>

        <TextField fx:id="emailField"
                   styleClass="input-field"
                   promptText="you@example.com"
                   maxWidth="Infinity"/>

        <Region prefHeight="18"/>

        <!-- Password -->
        <Label text="Password"
               style="-fx-text-fill: #9A9AA8; -fx-font-size: 12px; -fx-font-weight: bold;"/>

        <Region prefHeight="8"/>

        <PasswordField fx:id="passwordField"
                       styleClass="input-field"
                       promptText="Enter your password"
                       maxWidth="Infinity"/>

        <Region prefHeight="12"/>

        <!-- Error/success message -->
        <Label fx:id="messageLabel" text="" wrapText="true"/>

        <Region prefHeight="24"/>

        <!-- Login button -->
        <Button text="Sign in"
                onAction="#handleLogin"
                styleClass="next-button"
                maxWidth="Infinity"
                prefHeight="56"/>

        <!-- Spacer -->
        <Region VBox.vgrow="ALWAYS"/>

        <!-- Sign up link -->
        <HBox alignment="CENTER" spacing="6">
            <Label text="Don't have an account?"
                   style="-fx-text-fill: #9A9AA8; -fx-font-size: 13px;"/>
            <Label fx:id="signUpLink" text="Sign up"
                   style="-fx-text-fill: #FF8A3D; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;"
                   onMouseClicked="#goToOnboarding"/>
        </HBox>

        <Region prefHeight="20"/>

    </VBox>
</StackPane>